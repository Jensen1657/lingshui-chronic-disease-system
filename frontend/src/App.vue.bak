  font-size: 16px;
  border-bottom: 1px solid #4a5568;
}
.logo h2 {
  margin: 0;
  font-size: 16px;
  white-space: nowrap;
}
.header {
  background: #fff;
  border-bottom: 1px solid #e6e6e6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;

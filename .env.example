# 陵水县人民医院慢病管理系统 - 环境变量配置模板
# 复制此文件为 .env 并修改相应值

# ── 数据库配置 ──────────────────
# SQLite (开发环境)
# DATABASE_URL=sqlite+aiosqlite:///./slow_disease.db

# PostgreSQL (生产环境)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/slow_disease

# PostgreSQL 容器 (Docker Compose)
# DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@postgres:5432/slow_disease

# ── JWT 配置 ──────────────────
# 生产环境必须修改为随机强密码！
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8小时

# ── 加密配置 ──────────────────
# AES-128-CBC 加密密钥 (生产环境必须修改！)
# 生成方法: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-encryption-key

# ── 环境标识 ──────────────────
# development | production
ENVIRONMENT=production

# ── 日志配置 ──────────────────
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=/var/log/slow_disease/app.log

# ── Redis 配置 (可选，用于缓存) ──────────────────
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0  # Docker Compose

# ── CORS 配置 ──────────────────
# 允许的前端域名 (逗号分隔)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── 文件上传配置 ──────────────────
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# ── 邮件配置 (可选，用于提醒) ──────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com

# ── Docker Compose 专用 ──────────────────
# (仅在 docker-compose.yml 中使用)
DB_PASSWORD=your-secure-db-password
